{
  "name": "@yqt5421/pi-subagents-cn",
  "version": "0.49.3-cn.1",
  "description": "中文界面版子代理管理（fork 自 @narumitw/pi-subagents，UI 文案中文化）。Chinese-localized fork of pi-subagents with user-facing UI translated.",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "extension",
    "subagents",
    "agents",
    "automation",
    "chinese",
    "zh-cn",
    "i18n",
    "localization"
  ],
  "license": "MIT",
  "author": "yqt5420",
  "repository": {
    "type": "git",
    "url": "https://github.com/yqt5420/pi-extensions.git"
  },
  "publishConfig": {
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.49.1",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "check": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=/dev/null --external:@earendil-works/* --external:@narumitw/pi-tui-kit --external:proper-lockfile --external:typebox",
    "translate": "node scripts/translate.mjs",
    "sync": "node scripts/sync-upstream.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
